FoamFile
{
    version                 2.0;
    format                  ascii;
    arch                    "LSB;label=32;scalar=64";
    class                   volScalarField;
    location                "2000/dielectric";
    object                  epsilonR;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
dimensions              [0 0 0 0 0 0 0];
internalField           uniform 4;
boundaryField
{
    inlet
    {
        type                    calculated;
        value                   uniform 4;
    }
    outlet
    {
        type                    calculated;
        value                   uniform 4;
    }
    lowerElectrode
    {
        type                    calculated;
        value                   uniform 4;
    }
    dielectric_to_fluid
    {
        type                    calculated;
        value                   uniform 4;
    }
    front
    {
        type                    symmetryPlane;
    }
    back
    {
        type                    symmetryPlane;
    }
}
